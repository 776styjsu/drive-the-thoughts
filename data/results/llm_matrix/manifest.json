{
  "description": "Per-run judge outputs behind the paper's judge-based results: 4 judges x 2 monitors x 3 repeats, each scoring all 150 benchmark pairs. Paper tables use the 100 reliable pairs at score threshold 2 (score <= 2 is inconsistent). table1_run marks the median-F1 repeat reported in Table 1 and reused in the RQ4, latency, threshold and temporal tables.",
  "monitors": {
    "llm": "ego-frame monitor (raw waypoints in the ego frame)",
    "f_llm_map_graph": "lane-aware monitor (adds lane-relative evidence)"
  },
  "judges": {
    "qwen": {
      "paper_name": "Qwen3.5-4B",
      "model": "RedHatAI/Qwen3.5-4B-FP8-dynamic",
      "provider": "qwen35_4b_fp8_thinking_recommended",
      "route": "local vLLM server, one launch per repeat",
      "seeds": {
        "run_001": 42,
        "run_002": 43,
        "run_003": 44
      }
    },
    "deepseek": {
      "paper_name": "DeepSeek V4.1 Flash",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "provider": "deepseek_openrouter",
      "route": "OpenRouter, pinned to DeepSeek's endpoint, thinking mode, reasoning effort high"
    },
    "opus": {
      "paper_name": "Claude Opus 5.5",
      "model": "anthropic/claude-opus-5.5",
      "provider": "claude_opus_openrouter",
      "route": "OpenRouter Batch API (tools/run_openrouter_batch.py), pinned to Anthropic, effort high"
    },
    "jev": {
      "paper_name": "Jev 1.14",
      "model": "typesafe/jev-1.14-20261014",
      "provider": "jev_openrouter",
      "route": "OpenRouter decisions API (tools/run_jev_decisions.py); score = most probable rubric level"
    }
  },
  "repeats": "Hosted judges take no usable seed, so their repeats are independent samples. Qwen repeats are separate vLLM launches.",
  "cot_fix": "25 benchmark entries whose CoT was stored as a JSON list were re-judged in the string form every other entry uses, with the same settings; the cotfix_20261031 field in each Qwen, DeepSeek and Opus file lists the replaced clips. Jev ran after the fix. Paths in that field refer to the authors' run tree, which is not released.",
  "reproduce": "uv run python tools/check_consistency_accuracy.py --consistency-file data/results/llm_matrix/<file> --benchmark-file data/benchmark/benchmark.json --reliable-only",
